# Frontend environment (Vite). Everything here is PUBLIC: it is compiled into the
# bundle and readable by anyone. Never put a secret in this file.
#
# The browser holds no Supabase secret key and no Razorpay secret. Storage is
# reached only through signed URLs the API mints, and payments only through orders
# the API creates.

# Supabase project URL. MUST match SUPABASE_URL on the API service - the frontend
# obtains tokens from this project and the API verifies them against it, so a
# mismatch is a login that fails with "invalid token" and no other clue.
# `your-project` is the spelling tests/test_infra_contract.py recognises as a
# placeholder; replacing it with a real ref is what makes this file checkable.
VITE_SUPABASE_URL=https://your-project.supabase.co

# Publishable (anon) key. This is the browser-safe key by design - it grants
# nothing on its own, because row-level rules and the API's own authorization are
# what protect data.
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# API base URL. Leave EMPTY in development so requests go to the Vite dev server
# and are proxied to http://127.0.0.1:8000 (see vite.config.ts). In production set
# it to the Render service origin, e.g. https://caprep-api.onrender.com
VITE_API_BASE_URL=

# Public site origin, used for canonical URLs, Open Graph tags and the sitemap.
# Must match the domain the site is served from, or search engines treat the
# canonical URL as a different page.
VITE_SITE_URL=https://caprep.in

# Support address shown on the privacy and terms pages.
VITE_SUPPORT_EMAIL=support@caprep.in

# Which environment this build is. Defaults to development when unset. It is not
# cosmetic: the auth error card only shows its "open the Supabase console" link
# outside production, so an unset value in a production build would hand students a
# link to an admin console they cannot use.
VITE_APP_ENV=development
