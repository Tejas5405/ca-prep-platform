# ============================================================================
# CA Prep Platform - environment template
#
# Stack: React + TS (Vercel) | FastAPI (Render) | PostgreSQL | Redis + RQ
#        Supabase Auth + Supabase PostgreSQL + Supabase Storage | Tesseract / PyMuPDF
#
# Copy to .env and fill in. NEVER commit a real .env.
#
# SECRET-HANDLING RULE (blueprint v3 §5.1, amended by SA-05):
#   Anything prefixed VITE_ is compiled into the browser bundle and is PUBLIC.
#   Database URLs, service-role keys, payment secrets and API keys are
#   server-side only and must never be prefixed VITE_.
#
#   AUTH NOTE: identity, database and storage are all one Supabase project (SA-05,
#   SA-09). The browser holds the project URL and the PUBLISHABLE key, which are
#   public by design - they identify the project and authorise nothing. The
#   SECRET key below is server-side only: it is Postgres service_role with
#   BYPASSRLS, so anything holding it has the entire database and every bucket.
# ============================================================================

# ----------------------------------------------------------------- environment
ENVIRONMENT=development            # development | staging | production | test
DEBUG=true
API_V1_PREFIX=/api/v1

# ------------------------------------------------------------------- database
# psycopg 3 driver. Render provides a postgresql:// URL; alembic/env.py
# normalises the scheme automatically, so either form works here.
#
# SUPABASE: the connection string is in Project settings -> Database -> Connection
# string, and the DB password is NOT derivable from the API keys - it has to be
# copied from there.
#
#   Transaction pooler (port 6543)  -> DATABASE_URL. Serverless and multi-instance
#       friendly, but it cannot hold a session across statements, so the app
#       disables prepared statements (prepare_threshold=None for psycopg).
#   Direct connection (port 5432)   -> DIRECT_DATABASE_URL. Used for migrations,
#       which is why `alembic upgrade head` works through the pooler and over it.
#
# The pooler username carries the project ref: postgres.<ref>@aws-0-<region>.pooler.
# supabase.com:6543/postgres - a test uses it to prove the database and the token
# verifier point at the same project.
DATABASE_URL=postgresql+psycopg://caprep:caprep@localhost:5432/caprep
DIRECT_DATABASE_URL=

# ---------------------------------------------------------------------- redis
# Cache, rate limits, quotas, leaderboards, RQ queues.
REDIS_URL=redis://localhost:6379

# ---------------------------------------------------------------------- supabase
# One project, three jobs: Auth, PostgreSQL and Storage.
#
# SUPABASE_URL is the umbrella value. The API verifies the issuer and the audience
# of every access token against it, so it must be the SAME project the frontend is
# configured for (apps/web/.env.local) AND the one DATABASE_URL points at. A test in
# apps/api/tests/test_infra_contract.py asserts all three agree: a mismatch means
# sign-in succeeds in the browser and every API call returns 401, which from the
# server side is indistinguishable from an attack using another project's tokens.
#
# Point this at your own Supabase project; infra/render.yaml holds the deployed one.
SUPABASE_URL=https://your-project.supabase.co

# The SECRET key (sb_secret_...). SERVER-SIDE ONLY - never in a VITE_ variable, never
# in the frontend env file, never in a build argument.
#
# It is the equivalent of Postgres `service_role`: it bypasses row-level security
# and can read and write every row and every storage object in the project,
# including other students' files.
#
# Not needed to VERIFY a request: tokens are checked against the project's public
# JWKS, so no secret is on the authentication path at all. It is needed to MINT
# signed storage URLs and to set roles through the Admin API.
#
# Both values below transited a chat window while this project was being set up, so
# ROTATE THEM in the dashboard before real users: Project settings -> API keys ->
# rotate. Anything pasted into a chat, a ticket or a screenshot should be treated as
# public.
SUPABASE_SECRET_KEY=REPLACE_WITH_YOUR_SUPABASE_SECRET_KEY
STORAGE_BUCKET=question-pdfs

# Legacy JWT keys. The service_role key is a FALLBACK for SUPABASE_SECRET_KEY; the
# client detects the format and sends the right header, because the two key systems
# authenticate DIFFERENTLY (verified against a live project):
#
#   sb_secret_...   must be sent on the `apikey` header. It is not a JWT, so sending
#                   it as `Authorization: Bearer` returns 403 Invalid Compact JWS.
#   eyJ... (JWT)    legacy service_role keys must go on BOTH headers: apikey-only
#                   returns 400 "headers must have required property 'authorization'".
#
# Supabase retires the legacy keys at the end of 2026; prefer the secret key.
#
# SUPABASE_ANON_KEY is the legacy browser key. The frontend uses the new
# publishable key instead (VITE_SUPABASE_ANON_KEY in apps/web/.env.local), so this
# is normally empty. It is accepted here only so that a legacy deployment can be
# compared against the configured project by the infra tests.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# ------------------------------------------------------------- supabase storage
# Supabase is the identity provider AND the storage provider, and Storage RLS is
# still not the mechanism: the API is the single authorization boundary, and
# access is brokered with short-lived signed URLs - see the note at the end of
# app/core/security.py. One boundary, not two, and the browser must never hold a
# secret key (only the publishable one, which cannot list a single bucket).
#
# SUPABASE_SECRET_KEY is the current opaque secret key (sb_secret_...). The
# legacy service_role JWT also works here - the client detects the format and
# sends the right header, because the two key systems authenticate DIFFERENTLY:
#
#   sb_secret_...   must be sent on the `apikey` header. It is not a JWT, so
#                   sending it as `Authorization: Bearer` returns
#                   403 Invalid Compact JWS. Verified against a live project.
#   eyJ... (JWT)    legacy service_role keys go on BOTH headers.
#
# Supabase retires the legacy keys at the end of 2026; prefer the secret key.
#
# The PUBLISHABLE key (sb_publishable_...) is the browser-side equivalent and is
# what the frontend actually uses - see VITE_SUPABASE_ANON_KEY in
# apps/web/.env.example. It is public by design: `@supabase/supabase-js` cannot
# even initialise without one, and it authorises nothing on its own - verified
# against a live project, a publishable key lists ZERO storage buckets. It is NOT
# a second path to student files: every upload and download still goes through a
# signed URL the API mints, and the authorization boundary stays on the server.
#
# Note also what does NOT happen: the secret key never appears in a VITE_
# variable, in a build argument or in the bundle. tests/test_infra_contract.py
# scans the built output for exactly that.
#
# SUPABASE_URL is set once, at the top of this file. Do not repeat it here: a
# second assignment silently wins over the first, and an environment that copies
# this template would come up pointing at a project that does not exist.
SUPABASE_SECRET_KEY=REPLACE_WITH_YOUR_SUPABASE_SECRET_KEY
STORAGE_BUCKET=question-pdfs

# ------------------------------------------------------------------- payments
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ------------------------------------------------------------------ email/ops
RESEND_API_KEY=
POSTHOG_API_KEY=

# Empty = disabled. Get from sentry.io → project settings → Client Keys (DSN).
#
# A DSN is not quite a secret, but it is not public either: it embeds a public
# key that anyone can use to submit events into your project, so it stays
# server-side and out of any VITE_ variable. Leaving it empty is a supported
# state - the API boots and serves normally, and app/core/observability.py logs
# "Sentry disabled: no DSN configured" once at startup rather than failing.
SENTRY_DSN=

# ------------------------------------------------------------------ AI (later)
# AI is a Phase 3 item. A hard monthly ceiling is required - there is no
# unlimited mode, because the cost model goes negative quickly at Indian
# subscription price points.
AI_PROVIDER_API_KEY=
AI_PROVIDER_MODEL=gemini-3.8-flash
AI_MONTHLY_CEILING_USD=200
AI_FREE_QUERIES_PER_DAY=5

# --------------------------------------------------------------------- limits
FREE_DAILY_QUESTION_QUOTA=5
RATE_LIMIT_PER_MINUTE=100
MOCK_ATTEMPTS_PER_HOUR=10

# Required behind Render's proxy. Without this, XFF is ignored and every anonymous
# user shares the proxy IP as their rate-limit bucket → self-DoS at scale.
#
# 0 is correct for a local run: nothing is in front, so there is no
# X-Forwarded-For to trust. Staging and production both run behind Render's
# proxy, so both are 1 (see infra/render.yaml and .env.staging.example).
# Raising it above the real proxy-chain length is worse than 0: the bucket key
# then comes from a client-controlled header and the limiter can be walked around.
RATE_LIMIT_TRUSTED_PROXIES=0

# ----------------------------------------------------------------------- CORS
# Comma-separated allow-list. MUST be explicit in production; the app refuses to
# boot if this is empty or contains "*" when ENVIRONMENT=production.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ============================================================================
# FRONTEND (apps/web)
#
# The frontend has its OWN env file: apps/web/.env.local. See
# apps/web/.env.example. Only VITE_-prefixed variables reach the browser.
# ============================================================================

# Optional: used by Alembic when the app connects through a transaction-mode
# pooler (port 6543), which cannot hold a session across a migration's statements.
DIRECT_DATABASE_URL=
