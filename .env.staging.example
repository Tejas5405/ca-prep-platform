# ============================================================================
# STAGING environment template.  P2A - configuration only; nothing deployed.
# ============================================================================
#
# WHAT THIS FILE IS
#
# A copy-and-edit starting point for a STAGING deployment. Every value below is
# a PLACEHOLDER. Nothing here is a real credential, and nothing here has been
# used against a live service.
#
# HOW TO USE IT
#
# Do NOT commit a filled-in copy. Set these in your provider's dashboard (Render
# env vars, Vercel env vars) or in a local, gitignored `.env.staging`. This file
# exists so the NAMES are recorded once and correctly; the values live in the
# provider.
#
# ============================================================================
# NOTE ON THE PLACEHOLDER SYNTAX
#
# Every placeholder below is written as YOUR_NAME, not <NAME>. Two reasons, both
# found by actually loading this file rather than by reading it:
#
#   1. `<NAME>` is a shell REDIRECTION operator, so
#        CORS_ORIGINS=https://<STAGING_FRONTEND_HOST>
#      is a SYNTAX ERROR under `set -a; . ./.env.staging`; sourcing aborts part-way
#      and the remaining variables are silently not set.
#   2. `check_secrets.py` recognises `your` as a placeholder marker, so these stay
#      allow-listed as the documented fakes they are. An earlier `__NAME__` form
#      parsed cleanly but was flagged as a live database credential, which is the
#      scanner doing its job.
#
# The `YOUR_` prefix therefore satisfies both: valid shell, and recognisably fake.
# ============================================================================
# ============================================================================
# THE ONE RULE
# ============================================================================
#
# Every URL below must point at the STAGING Supabase project, STAGING database
# and STAGING Redis. The existing development project must NOT appear here.
# `Settings.staging_isolation_problems()` reports a shared or local resource at
# runtime, and `docs/STAGING_DEPLOYMENT_STATUS.md` records that no staging
# project exists yet.
#
# ============================================================================
# ENVIRONMENT IDENTITY
# ============================================================================
#
# `staging` is not cosmetic. It selects CORS strictness and boot behaviour, and
# it activates the two guards in `app/core/config.py`:
#   - a staging box holding a `rzp_live_` Razorpay key REFUSES TO BOOT
#   - a staging box on a local database/Redis/Supabase is REPORTED
#
ENVIRONMENT=staging
DEBUG=false

# ============================================================================
# DATABASE - STAGING instance, never the development database
# ============================================================================
#
# The app may use a Supabase transaction pooler (port 6543). Alembic must use the
# DIRECT connection: the pooler cannot hold a session across the advisory lock
# that `alembic upgrade` takes, which is the classic way to get a half-applied
# schema. Leave DIRECT_DATABASE_URL empty only if there is no pooler.
#
# The placeholder host is deliberately the shape Supabase uses, so a value pasted
# in here is obviously still a placeholder until the real project exists.
#
DATABASE_URL=postgresql+psycopg://postgres.your-STAGING_PROJECT_REF:your-STAGING_DB_PASSWORD@aws-0-your-STAGING_REGION.pooler.supabase.com:6543/postgres
DIRECT_DATABASE_URL=postgresql+psycopg://postgres:your-STAGING_DB_PASSWORD@db.your-STAGING_PROJECT_REF.supabase.co:5432/postgres

# ============================================================================
# SUPABASE - the STAGING project. Auth, database and storage all come from this.
# ============================================================================
#
# SUPABASE_URL is NOT a secret: it ships in the browser bundle. It is the single
# value that makes issuer/audience verification meaningful, so it MUST equal the
# frontend's VITE_SUPABASE_URL or every API call returns 401.
#
# SUPABASE_SECRET_KEY is the Postgres service_role with BYPASSRLS. SERVER-SIDE
# ONLY. It mints signed URLs and brokers storage. Never set it as a VITE_ variable
# and never let it reach the browser.
#
SUPABASE_URL=https://your-STAGING_PROJECT_REF.supabase.co
SUPABASE_SECRET_KEY=
# Only for the Supabase CLI. The application reads SUPABASE_SECRET_KEY, and
# `Settings` maps the legacy name onto it so an old environment keeps working
# until Supabase retires the legacy keys.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# ============================================================================

# ============================================================================
# REDIS - STAGING instance
# ============================================================================
#
# Must NOT be localhost or 127.0.0.1: Redis carries the RQ job queue, so a
# staging deployment sharing it would have its jobs executed by a developer's
# local worker - and ingest that developer's PDFs. The guard reports this.
#
REDIS_URL=redis://:your-STAGING_REDIS_PASSWORD@your-STAGING_REDIS_HOST:6379

# ============================================================================
# PAYMENTS - Razorpay TEST MODE ONLY
# ============================================================================
#
# Get these from the Razorpay dashboard with Test mode toggled ON. A live-mode
# key id starts `rzp_live_`; a test-mode one starts `rzp_test_`. They talk to
# the SAME host - the prefix is the only discriminator, which is why `Settings`
# refuses to construct with a live key when ENVIRONMENT=staging.
#
# Never commit these. Never paste them into a ticket or a screenshot.
#
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Overridable so a local mock can stand in. The guard keys on the key id
# prefix, so pointing this at a mock is fine.
RAZORPAY_BASE_URL=https://api.razorpay.com/v1

# ============================================================================
# AI - a staging-scoped credential
# ============================================================================
#
# AI_PROVIDER_FALLBACK_MODEL must DIFFER from AI_PROVIDER_MODEL or startup
# fails: a fallback on the same model retries the same outage.
#
# Leave the key EMPTY rather than reusing the development one. AI is the one
# integration where sharing a credential is easy to do by accident, because
# nothing about a wrong key is visible until a request is made.
#
AI_PROVIDER_API_KEY=
AI_PROVIDER_MODEL=gemini-3.8-flash
AI_PROVIDER_FALLBACK_MODEL=
AI_MONTHLY_CEILING_USD=200.0
AI_FREE_QUERIES_PER_DAY=5

# ============================================================================
# CORS - the STAGING frontend origin, and nothing else
# ============================================================================
#
# An explicit allow-list. The application refuses to boot in production if this
# is empty or contains "*", and the same reasoning applies here: a wildcard on a
# staging origin means any site can call the API with a stolen token.
#
# Comma-separated, or a JSON array - both are accepted.
#
CORS_ORIGINS=https://your-STAGING_FRONTEND_HOST

# ============================================================================
# RATE LIMITING - proxy trust
# ============================================================================
#
# Required behind Render's proxy. Without this, XFF is ignored and every anonymous
# user shares the proxy IP as their rate-limit bucket → self-DoS at scale.
#
# Staging runs behind Render exactly as production does, so this is 1 here and 1
# in infra/render.yaml. Raising it above the real proxy-chain length is worse
# than 0: the bucket key then comes from a client-controlled header.
RATE_LIMIT_TRUSTED_PROXIES=1

# ============================================================================
# OPTIONAL - leave empty unless the staging environment needs them
# ============================================================================
#
# BOOTSTRAP_ADMIN_EMAILS is how the first staging administrator is created. Use
# synthetic staging addresses, never a real person's.
#
BOOTSTRAP_ADMIN_EMAILS=
RESEND_API_KEY=
SENTRY_DSN=
POSTHOG_API_KEY=

# ============================================================================
# FRONTEND (apps/web) - build-time, and a different set entirely
# ============================================================================
#
# These are NOT read from this file. They are set in the frontend host's
# dashboard and inlined by Vite at build time. Listed here because a staging
# deploy needs both halves, and the pairing is the single most common failure:
# a frontend pointed at a different Supabase project than the API means sign-in
# succeeds and every request then 401s.
#
#   VITE_SUPABASE_URL       = the same project as SUPABASE_URL above
#   VITE_SUPABASE_ANON_KEY  = the project's publishable key (public by design)
#   VITE_API_BASE_URL       = the staging API origin, e.g. https://<API_HOST>
#   VITE_APP_ENV            = staging
#   VITE_SITE_URL           = the staging frontend origin
#
# VITE_APP_ENV gates the "open console link" affordance, which is intentionally
# hidden in production. staging shows it, which is what you want on staging.
#
# NOT SETTABLE HERE, and there is no reason to want to: SUPABASE_SECRET_KEY,
# DATABASE_URL, REDIS_URL, the Razorpay secret, the webhook secret, the AI key.
# Vite inlines anything prefixed VITE_ into the client bundle, so a VITE_-prefixed
# secret is a published secret.

# STORAGE - private buckets on the STAGING project
# ============================================================================
#
# All buckets are PRIVATE. Access is by signed URL minted server-side. Making a
# bucket public to fix an access error would expose every uploaded paper, so it
# is never the answer - the symptom is usually a wrong key or a wrong project.
#
# Three buckets are in use (question-pdfs, question-media, user-uploads). Only
# question-pdfs is configurable by environment variable today; the other two
# are referenced in code. A staging project needs all three created, private.
#
STORAGE_BUCKET=question-pdfs
